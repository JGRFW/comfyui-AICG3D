enoise"},"link":null}],"outputs":[{"label":"Sigmas","localized_name":"Sigmas","name":"SIGMAS","type":"SIGMAS","links":[8]}],"properties":{"Node name for S&R":"BasicScheduler","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"},"cnr_id":"comfy-core","ver":"0.30.2"},"widgets_values":["simple",8,1.0],"widgets_values_named":{"scheduler":"simple","steps":8,"denoise":1.0},"color":"#223","bgcolor":"#335","title":"步数 / 调度（配 3 步 LoRA 用 8 步）"},{"id":8,"type":"AICG3D_H3SegmentRender","pos":[700,380],"size":[330,230],"flags":{},"order":8,"mode":0,"inputs":[{"name":"h3_context","type":"MINIMAX_H3_CONTEXT","link":10},{"name":"sampler","type":"SAMPLER","link":9},{"name":"sigmas","type":"SIGMAS","link":8},{"name":"seed","type":"INT","link":null,"widget":{"name":"seed"}},{"name":"segment_seeds","type":"STRING","link":null,"widget":{"name":"segment_seeds"}},{"name":"model","type":"MODEL","link":7},{"name":"sampling_plan","type":"default","link":null}],"outputs":[{"name":"segments","type":"MINIMAX_H3_SEGMENTS","links":[11],"slot_index":0}],"widgets_values":[0,"default"],"properties":{"Node name for S&R":"AICG3D_H3SegmentRender"},"widgets_values_named":{"seed":0,"segment_seeds":"default"},"title":"⑥ 分段采样（逐段执行）"},{"id":9,"type":"AICG3D_H3SegmentDecode","pos":[1400,380],"size":[320,130],"flags":{},"order":9,"mode":0,"inputs":[{"name":"segments","type":"MINIMAX_H3_SEGMENTS","link":11}],"outputs":[{"name":"preview","type":"VIDEO","links":[12],"slot_index":0}],"widgets_values":[],"properties":{"Node name for S&R":"AICG3D_H3SegmentDecode"},"title":"⑦ 分段解码（拼回完整视频，保留原音轨）"},{"id":10,"type":"SaveVideo","pos":[2020,380],"size":[610,510],"flags":{},"order":10,"mode":0,"inputs":[{"label":"视频","localized_name":"视频","name":"video","type":"VIDEO","link":12},{"localized_name":"文件名前缀","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null},{"localized_name":"格式","name":"format","type":"COMFY_DYNAMICCOMBO_V3","widget":{"name":"format"},"link":null},{"localized_name":"编解码器","name":"format.codec","type":"COMFY_DYNAMICCOMBO_V3","widget":{"name":"format.codec"},"link":null},{"localized_name":"编解码器","name":"codec","shape":7,"type":"COMFY_DYNAMICCOMBO_V3","widget":{"name":"codec"},"link":null}],"outputs":[{"localized_name":"video","name":"video","type":"VIDEO","links":[]}],"properties":{"Node name for S&R":"SaveVideo"},"widgets_values":["video/AICG3D_分段替换","auto","auto","auto"],"widgets_values_named":{"filename_prefix":"video/AICG3D_分段替换","format":"auto","format.codec":"auto","codec":"auto"},"title":"⑧ 输出成片"},{"id":11,"type":"MarkdownNote","pos":[-1620,-760],"size":[900,700],"flags":{},"order":11,"mode":0,"inputs":[],"outputs":[],"title":"分段替换 · 怎么用","properties":{"ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"},"widget_ue_connectable":{}},"widgets_values":["# 分段替换长视频（换人物 / 换场景）\n\n**为什么要分段**：两分钟以上的参考视频，一次性替换基本会显存爆掉或直接卡死。这里按「每段 N 秒」切成很多小段，**一段一段替换**，最后自动拼回一条完整视频，**声音仍然是原视频的**（按段裁切原音轨，不需要另外配音）。\n\n## 接线（已经接好）\n```\n② Load Video ─┬─→ ④ 自动分段切点 ─ segment_cuts ─→ ⑤ 已选视频上下文\n              └───────────────────────────────────→ ⑤（selected_video）\n③ Load Image（人物参考图）───────────────────────→ ⑤（media）\n① 加载器 h3_bundle ─────────────────────────────→ ⑤\n⑤ model ─→ 调度器 / ⑥ ；⑤ h3_context ─→ ⑥ 分段采样 ─→ ⑦ 分段解码 ─→ ⑧ 输出\n```\n\n## 开跑前要改 3 处\n1. **① 加载器**：选你的 H3 主干（**多参考 / 融合权重最合适**）、文本编码器、双 VAE；LoRA 槽位默认挂了 3 步加速 LoRA，不想要就改成 none。\n2. **② Load Video**：换成你要替换的那条长视频。\n3. **③ Load Image**：换成「要换上去的人」的清晰参考图；⑤ 的提示词里用 `<Picture 1>` 指它。\n\n## 关键参数\n- ④ **每段秒数**：默认 5 秒 → 2 分钟切 24 段。想更稳就切小（3~5 秒），想更快就切大（8~15 秒）。\n- ④ **对齐 17 帧网格**：**必须保持开启**。默认连续性 latent_guide 要求切点落在 17 帧网格上，关掉很容易被拒绝；开了以后 5 秒实际是 4.96 秒，属正常。\n- ⑤ `segment_mode = time_cuts`（已设好），`segment_cuts` 由 ④ 自动喂进来，**不用手写**。\n- 采样：`res_multistep + simple + 8 步`（配 3 步加速 LoRA 够用）。不用 LoRA 请把步数提到 30 以上。\n- ⑥ 分段采样是**逐段串行**的：显存只跟单段有关，这就是它不会卡死的原因；总耗时 ≈ 段数 × 单段耗时（24 段 ≈ 跑 24 次 5 秒）。\n\n## 想让效果更好\n- 每段提示词可以写得更具体（谁、穿什么、什么动作）；⑥ 支持给每段不同种子。\n- 追求清晰度时，在 ⑦ 之前插一个「分段二采」（AICG3D_H3SegmentRefine）再解码。"],"widgets_values_named":{"text":"# 分段替换长视频（换人物 / 换场景）\n\n**为什么要分段**：两分钟以上的参考视频，一次性替换基本会显存爆掉或直接卡死。这里按「每段 N 秒」切成很多小段，**一段一段替换**，最后自动拼回一条完整视频，**声音仍然是原视频的**（按段裁切原音轨，不需要另外配音）。\n\n## 接线（已经接好）\n```\n② Load Video ─┬─→ ④ 自动分段切点 ─ segment_cuts ─→ ⑤ 已选视频上下文\n              └───────────────────────────────────→ ⑤（selected_video）\n③ Load Image（人物参考图）───────────────────────→ ⑤（media）\n① 加载器 h3_bundle ─────────────────────────────→ ⑤\n⑤ model ─→ 调度器 / ⑥ ；⑤ h3_context ─→ ⑥ 分段采样 ─→ ⑦ 分段解码 ─→ ⑧ 输出\n```\n\n## 开跑前要改 3 处\n1. **① 加载器**：选你的 H3 主干（**多参考 / 融合权重最合适**）、文本编码器、双 VAE；LoRA 槽位默认挂了 3 步加速 LoRA，不想要就改成 none。\n2. **② Load Video**：换成你要替换的那条长视频。\n3. **③ Load Image**：换成「要换上去的人」的清晰参考图；⑤ 的提示词里用 `<Picture 1>` 指它。\n\n## 关键参数\n- ④ **每段秒数**：默认 5 秒 → 2 分钟切 24 段。想更稳就切小（3~5 秒），想更快就切大（8~15 秒）。\n- ④ **对齐 17 帧网格**：**必须保持开启**。默认连续性 latent_guide 要求切点落在 17 帧网格上，关掉很容易被拒绝；开了以后 5 秒实际是 4.96 秒，属正常。\n- ⑤ `segment_mode = time_cuts`（已设好），`segment_cuts` 由 ④ 自动喂进来，**不用手写**。\n- 采样：`res_multistep + simple + 8 步`（配 3 步加速 LoRA 够用）。不用 LoRA 请把步数提到 30 以上。\n- ⑥ 分段采样是**逐段串行**的：显存只跟单段有关，这就是它不会卡死的原因；总耗时 ≈ 段数 × 单段耗时（24 段 ≈ 跑 24 次 5 秒）。\n\n## 想让效果更好\n- 每段提示词可以写得更具体（谁、穿什么、什么动作）；⑥ 支持给每段不同种子。\n- 追求清晰度时，在 ⑦ 之前插一个「分段二采」（AICG3D_H3SegmentRefine）再解码。"},"color":"#333","bgcolor":"#353535"},{"id":12,"type":"MarkdownNote","pos":[-680,-760],"size":[860,700],"flags":{},"order":12,"mode":0,"inputs":[],"outputs":[],"title":"报错 / 卡死排查","properties":{"ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"},"widget_ue_connectable":{}},"widgets_values":["## 报错 / 卡死排查\n\n**「cuts cannot be aligned」**\n切点没落在 17 帧网格上。别手写切点 → 用 ④ 自动分段切点，并保持「对齐 17 帧网格」开启。\n\n**每段太短被拒绝 / 段数超上限**\nlatent_guide 下每段最短 17 帧（24fps ≈ 0.71 秒），所以请求 1 秒会被贴成 0.71 秒；④ 的「最多段数」默认 120，2 分钟 5 秒只要 24 段，够用。真要 1 秒一段就把它调到 200 左右，但要清楚那意味着 169 段、总时长 × 169。\n\n**还是卡死 / 爆显存**\n- 把 ④ 每段秒数调小（3~5 秒），确认段数在 20~40；\n- 分辨率别拉太高（先用 720P 试）；\n- 先关掉节点上的预览；\n- 一次只跑一种模式，别同时挂着二采分块。\n\n**人物没换掉 / 换了但不像**\n- ③ 的参考图要清晰、正脸、少遮挡；\n- ⑤ `mode` 用 **reference**（参考生视频），提示词里明确写 `<Picture 1>` 是谁、什么特征；\n- `ref_image_size` 可以提到 1.5k / 2k（更清晰，但更吃显存）。\n\n**只想替换其中一段**\n目前切点必须覆盖整条视频。折中方案：先把参考视频剪成「要替换的那一段」，替换完再和其余原始素材拼接。"],"widgets_values_named":{"text":"## 报错 / 卡死排查\n\n**「cuts cannot be aligned」**\n切点没落在 17 帧网格上。别手写切点 → 用 ④ 自动分段切点，并保持「对齐 17 帧网格」开启。\n\n**每段太短被拒绝 / 段数超上限**\nlatent_guide 下每段最短 17 帧（24fps ≈ 0.71 秒），所以请求 1 秒会被贴成 0.71 秒；④ 的「最多段数」默认 120，2 分钟 5 秒只要 24 段，够用。真要 1 秒一段就把它调到 200 左右，但要清楚那意味着 169 段、总时长 × 169。\n\n**还是卡死 / 爆显存**\n- 把 ④ 每段秒数调小（3~5 秒），确认段数在 20~40；\n- 分辨率别拉太高（先用 720P 试）；\n- 先关掉节点上的预览；\n- 一次只跑一种模式，别同时挂着二采分块。\n\n**人物没换掉 / 换了但不像**\n- ③ 的参考图要清晰、正脸、少遮挡；\n- ⑤ `mode` 用 **reference**（参考生视频），提示词里明确写 `<Picture 1>` 是谁、什么特征；\n- `ref_image_size` 可以提到 1.5k / 2k（更清晰，但更吃显存）。\n\n**只想替换其中一段**\n目前切点必须覆盖整条视频。折中方案：先把参考视频剪成「要替换的那一段」，替换完再和其余原始素材拼接。"},"color":"#333","bgcolor":"#353535"}],"links":[[1,2,0,4,4,"VIDEO"],[2,2,0,5,1,"VIDEO"],[3,1,0,5,0,"MINIMAX_H3_BUNDLE"],[4,3,0,5,16,"IMAGE"],[5,4,0,5,5,"STRING"],[6,5,0,7,0,"MODEL"],[7,5,0,8,5,"MODEL"],[8,7,0,8,2,"SIGMAS"],[9,6,0,8,1,"SAMPLER"],[10,5,1,8,0,"MINIMAX_H3_CONTEXT"],[11,8,0,9,0,"MINIMAX_H3_SEGMENTS"],[12,9,0,10,0,"VIDEO"]],"groups":[],"config":{},"extra":{},"version":0.4}